# Copy to .env. Never commit .env (see .gitignore). All keys are prefixed SLABSPREAD_.
SLABSPREAD_DATABASE_URL=sqlite:///./slabspread.db
# Supabase Postgres, when provisioned:
# SLABSPREAD_DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Identity thresholds (plan §3). Fuzzy matches are candidates only, never trusted.
SLABSPREAD_FUZZY_CANDIDATE_MIN=0.70
SLABSPREAD_FUZZY_RECORD_MIN=0.55
