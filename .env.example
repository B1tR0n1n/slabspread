# Copy to .env. Never commit .env (see .gitignore). All keys are prefixed SLABSPREAD_.
SLABSPREAD_DATABASE_URL=sqlite:///./slabspread.db
# Supabase Postgres, when provisioned:
# SLABSPREAD_DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Identity thresholds (plan §3). Fuzzy matches are candidates only, never trusted.
SLABSPREAD_FUZZY_CANDIDATE_MIN=0.70
SLABSPREAD_FUZZY_RECORD_MIN=0.55

# --- Phase 4: owner auth + alerts ---------------------------------------------------------
# local: python -m app.auth 'your password'  → paste the hash below
SLABSPREAD_AUTH_MODE=local
SLABSPREAD_OWNER_EMAIL=you@example.com
SLABSPREAD_OWNER_PASSWORD_HASH=
SLABSPREAD_SESSION_SECRET=generate-a-long-random-string
# supabase mode instead: SLABSPREAD_AUTH_MODE=supabase + the project's URL, anon key, JWT secret
SLABSPREAD_SUPABASE_URL=
SLABSPREAD_SUPABASE_ANON_KEY=
SLABSPREAD_SUPABASE_JWT_SECRET=
SLABSPREAD_ALERT_FLOOR_MARGIN_MIN=10
SLABSPREAD_ALERT_COOLDOWN_HOURS=12
# email alerts (omit to log only)
SLABSPREAD_SMTP_HOST=
SLABSPREAD_SMTP_PORT=587
SLABSPREAD_SMTP_USER=
SLABSPREAD_SMTP_PASSWORD=
SLABSPREAD_ALERT_EMAIL_TO=
SLABSPREAD_ALERT_EMAIL_FROM=

# --- Phase 5: public site ---------------------------------------------------------------------
SLABSPREAD_SITE_BASE_URL=https://example.com
SLABSPREAD_SITE_NAME=SlabSpread
SLABSPREAD_SITE_OUT_DIR=public
SLABSPREAD_ANALYTICS_SNIPPET=
# affiliate links only where program terms allow public use (phase0 Q7); JSON map platform→url
SLABSPREAD_AFFILIATE_LINKS={}

# --- Phase 6: paid tier (all gates default off) ----------------------------------------------
SLABSPREAD_PAID_TIER_ENABLED=false
SLABSPREAD_STRIPE_SECRET_KEY=
SLABSPREAD_STRIPE_WEBHOOK_SECRET=
SLABSPREAD_STRIPE_PRICE_ID=
SLABSPREAD_LAUNCH_LICENSES_CONFIRMED=false
SLABSPREAD_LAUNCH_TERMS_REVIEWED=false
SLABSPREAD_LAUNCH_MIN_CALIBRATED_TRADES=30
